---
import "../styles/theme.css";
import Analytics from "@vercel/analytics/astro";
import { portfolio } from "../lib/portfolio";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown>;
}

const {
  title = `${portfolio.name} — Machine Learning Engineer & AI Researcher`,
  description = `${portfolio.name} is a Machine Learning Engineer and AI Researcher building practical systems in forecasting, computer vision, and recommendations.`,
  canonicalPath = Astro.url.pathname,
  type = "website",
  publishedAt,
  tags = [],
  structuredData,
} = Astro.props;
const canonicalUrl = Astro.site && new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={portfolio.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={portfolio.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @font-face {
    font-family: "Mononoki Nerd Font";
    src: url("/fonts/MononokiNerdFont-Regular.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Mononoki Nerd Font Bold Italic";
    src: url("/fonts/MononokiNerdFont-BoldItalic.ttf") format("truetype");
    font-weight: bold;
    font-style: italic;
    font-display: swap;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background: rgb(var(--color-canvas));
    color: rgb(var(--color-text-primary));
    scroll-behavior: smooth;
  }

  html {
    color-scheme: dark;
    scrollbar-color: rgb(var(--color-strong)) rgb(var(--color-canvas));
    scrollbar-width: thin;
  }

  body {
    font-family: "Mononoki Nerd Font";
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-wrap: break-word;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      rgb(var(--color-text-primary) / 2.5%) 1px,
      transparent 1px
    );
    background-size: 100% 4rem;
    content: "";
    pointer-events: none;
  }

  .page-shell {
    padding-block: max(1.75rem, env(safe-area-inset-top))
      max(4rem, env(safe-area-inset-bottom));
    padding-inline: max(1.5rem, env(safe-area-inset-left))
      max(1.5rem, env(safe-area-inset-right));
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  button {
    font: inherit;
  }

  ::selection {
    background: rgb(var(--color-link));
    color: rgb(var(--color-canvas));
  }

  :focus-visible {
    outline: 2px solid rgb(var(--color-link));
    outline-offset: 4px;
  }

  dialog::backdrop {
    background: rgb(var(--color-scrim) / 76%);
    backdrop-filter: blur(3px);
  }

  @media (min-width: 40rem) {
    .page-shell {
      padding-block-start: max(2rem, env(safe-area-inset-top));
      padding-inline: max(1.75rem, env(safe-area-inset-left))
        max(1.75rem, env(safe-area-inset-right));
    }
  }

  @media (min-width: 64rem) {
    .page-shell {
      padding-block-start: max(2.5rem, env(safe-area-inset-top));
      padding-inline: max(2.5rem, env(safe-area-inset-left))
        max(2.5rem, env(safe-area-inset-right));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
