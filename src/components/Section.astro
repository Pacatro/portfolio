---
import TextSection from "./sections/text.astro";
import type { SectionRendererProps } from "../lib/portfolio";

type Props = SectionRendererProps;

const props = Astro.props;
const rendererModules = import.meta.glob("./sections/*.astro", { eager: true });
const rendererPath = `./sections/${props.section.type}.astro`;
const rendererModule = rendererModules[rendererPath];

if (!rendererModule) {
  throw new Error(
    `No renderer found for section type “${props.section.type}”. ` +
      `Create src/components/sections/${props.section.type}.astro.`,
  );
}

const Renderer = (rendererModule as { default: typeof TextSection }).default;
---

<Renderer {...props} />
