---
import BlogSection from "./sections/blog.astro";
import ProjectsSection from "./sections/projects.astro";
import TextSection from "./sections/text.astro";
import type { SectionRendererProps } from "../lib/portfolio";

type Props = SectionRendererProps;

const props = Astro.props;
const renderers = {
  blog: BlogSection,
  projects: ProjectsSection,
  text: TextSection,
} as const;
const Renderer = renderers[props.section.type as keyof typeof renderers];

if (!Renderer) {
  throw new Error(
    `No renderer found for section type “${props.section.type}”. ` +
      `Create src/components/sections/${props.section.type}.astro.`,
  );
}
---

<Renderer {...props} />
