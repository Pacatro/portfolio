---
import type { SectionRendererProps } from "../lib/portfolio";

type Props = SectionRendererProps;

type SectionComponent = (props: SectionRendererProps) => unknown;

const props = Astro.props;
const renderers = import.meta.glob<{ default: SectionComponent }>(
  "./sections/*.astro",
);
const loadRenderer = renderers[`./sections/${props.section.type}.astro`];

if (!loadRenderer) {
  throw new Error(
    `No renderer found for section type “${props.section.type}”. ` +
      `Create src/components/sections/${props.section.type}.astro.`,
  );
}

const { default: Renderer } = await loadRenderer();
---

<Renderer {...props} />
