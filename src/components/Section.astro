---
import Projects from "./Projects.astro";

interface Social {
  name: string;
  url: string;
  icon: string;
}
interface Props {
  section: {
    id: string;
    path: string;
    command: string;
    type: string;
    content?: string;
    items?: Social[];
  };
}

const { section } = Astro.props;
const isFooter = section.type === "socials";
const Tag = isFooter ? "footer" : "section";
---

<Tag
  class:list={["mt-14 scroll-mt-6 sm:mt-20 sm:scroll-mt-8", { "mb-16": isFooter }]}
  id={section.id}
>
  <div
    class="mb-6 flex items-end justify-between gap-5 border-b border-[#363a4f] pb-3 text-base leading-7"
  >
    <div>
      <p class="text-xs uppercase tracking-[0.12em] text-[#939ab7]">
        ~/{section.path}
      </p>
      <p
        class="mt-1 text-xl font-bold tracking-[-0.02em] text-[#cad3f5] sm:text-2xl"
      >
        <span class="mr-1 text-[#8bd5ca]" aria-hidden="true">›</span>
        {section.command}
      </p>
    </div>
  </div>
  {
    section.type === "text" && (
      <p class="max-w-[72ch] text-base leading-7 text-[#b8c0e0] sm:text-lg sm:leading-8">
        {section.content}
      </p>
    )
  }
  {
    section.type === "projects" && (
      <Projects server:defer>
        <ul slot="fallback" class="w-full">
          {Array.from({ length: 3 }).map(() => (
            <li class="my-2 list-none animate-pulse border-b border-[#343746] px-1 py-5">
              <div class="mb-3 h-5 w-1/3 rounded bg-[#494d64]/40" />
              <div class="mb-2 h-4 w-3/4 rounded bg-[#494d64]/30" />
              <div class="h-4 w-1/2 rounded bg-[#494d64]/30" />
            </li>
          ))}
        </ul>
      </Projects>
    )
  }
  {
    section.type === "socials" && (
      <div class="grid gap-px overflow-hidden rounded-xl border border-[#363a4f] bg-[#363a4f] sm:grid-cols-3">
        {section.items?.map(({ name, url, icon }) => (
          <a
            href={
              name.toLowerCase() === "email"
                ? `mailto:${url}`
                : `https://${url}`
            }
            aria-label={name}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-14 min-w-0 items-center gap-3 bg-[#1e2030] px-4 py-4 no-underline transition-colors hover:bg-[#24273a] active:bg-[#24273a] sm:py-5"
          >
            <img
              src={icon}
              alt=""
              class="h-5 w-5 opacity-70 transition-opacity group-hover:opacity-100"
            />
            <span class="font-semibold text-base text-[#cad3f5]">{name}</span>
            <span
              class="ml-auto text-[#6e738d] transition-colors group-hover:text-[#8bd5ca]"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        ))}
      </div>
    )
  }
</Tag>
