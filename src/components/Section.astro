---
import Projects from "./Projects.astro";

interface Social {
  name: string;
  url: string;
  icon: string;
}
interface Props {
  section: {
    id: string;
    path: string;
    command: string;
    type: string;
    content?: string;
    items?: Social[];
  };
  socialItems?: Social[];
}

const { section, socialItems = [] } = Astro.props;
---

<section
  class="mt-14 scroll-mt-6 sm:mt-20 sm:scroll-mt-8"
  id={section.id}
>
  <div
    class="mb-6 flex items-end justify-between gap-5 border-b border-[#363a4f] pb-3 text-base leading-7"
  >
    <div>
      <p class="text-xs uppercase tracking-[0.12em] text-[#939ab7]">
        ~/{section.path}
      </p>
      <p
        class="mt-1 text-xl font-bold tracking-[-0.02em] text-[#cad3f5] sm:text-2xl"
      >
        <span class="mr-1 text-[#8bd5ca]" aria-hidden="true">›</span>
        {section.command}
      </p>
    </div>
  </div>
  {
    section.type === "text" && (
      <div>
        <p class="max-w-[72ch] text-base leading-7 text-[#b8c0e0] sm:text-lg sm:leading-8">
          {section.content}
        </p>
        <nav
          class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 sm:mt-6"
          aria-label="Social profiles and contact"
        >
          {socialItems.map(({ name, url, icon }) => {
            const isEmail = name.toLowerCase() === "email";

            return (
              <a
                href={isEmail ? `mailto:${url}` : `https://${url}`}
                target={isEmail ? undefined : "_blank"}
                rel={isEmail ? undefined : "noopener noreferrer"}
                class="group flex min-h-11 items-center gap-2 border-b-2 border-transparent px-1 py-2 font-semibold text-[#a5adcb] no-underline transition-colors hover:border-[#8aadf4] hover:text-[#cad3f5] active:border-[#8aadf4] active:text-[#cad3f5]"
              >
                <img
                  src={icon}
                  alt=""
                  class="h-5 w-5 opacity-70 transition-opacity group-hover:opacity-100"
                />
                <span>{name}</span>
                {!isEmail && <span class="text-[#6e738d]" aria-hidden="true">↗</span>}
              </a>
            );
          })}
        </nav>
      </div>
    )
  }
  {
    section.type === "projects" && (
      <Projects server:defer>
        <ul slot="fallback" class="w-full">
          {Array.from({ length: 3 }).map(() => (
            <li class="my-2 list-none animate-pulse border-b border-[#343746] px-1 py-5">
              <div class="mb-3 h-5 w-1/3 rounded bg-[#494d64]/40" />
              <div class="mb-2 h-4 w-3/4 rounded bg-[#494d64]/30" />
              <div class="h-4 w-1/2 rounded bg-[#494d64]/30" />
            </li>
          ))}
        </ul>
      </Projects>
    )
  }
</section>
