---
import type { SocialLink } from "../lib/portfolio";
import { getSocialHref, isEmailLink } from "../lib/social-links";
interface Props {
  links: SocialLink[];
}
const { links } = Astro.props;
---

<nav
  class="mt-5 flex flex-wrap items-center gap-1 sm:mt-6"
  aria-label="Social profiles and contact"
>
  {
    links.map((link) => {
      const { name, icon } = link;
      const isEmail = isEmailLink(link);
      return (
        <a
          href={getSocialHref(link)}
          target={isEmail ? undefined : "_blank"}
          rel={isEmail ? undefined : "noopener noreferrer"}
          class="group flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold tracking-[-0.01em] text-[#a5adcb] no-underline transition-all first:pl-0 hover:-translate-y-0.5 hover:text-[#cad3f5] active:translate-y-0 active:border-[#494d64] sm:px-3.5 sm:first:pl-0"
        >
          <span
            class="grid h-6 w-6 place-items-center rounded transition-colors"
            aria-hidden="true"
          >
            <img
              src={icon}
              alt=""
              class="h-4 w-4 opacity-75 transition-opacity group-hover:opacity-100"
            />
          </span>
          <span>{name}</span>
          <svg
            class="h-3 w-3 text-[#6e738d] transition-colors group-hover:text-[#8bd5ca]"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 9 9 3M4 3h5v5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      );
    })
  }
</nav>
