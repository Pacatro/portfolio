---
interface Props {
  name: string;
  sections: { id: string }[];
}

const { name, sections } = Astro.props;
---

<header
  class="flex flex-col items-center gap-4 border-b border-[#363a4f] pb-4 lg:flex-row lg:justify-between lg:gap-6"
>
  <div
    class="flex min-w-0 w-full items-center justify-center gap-3 lg:w-auto lg:justify-start"
  >
    <a
      href="/"
      class="min-w-0 truncate text-lg font-bold tracking-[-0.02em] text-[#c6a0f6] no-underline sm:text-xl"
    >
      {name}
    </a>
  </div>

  <nav
    class="flex w-full flex-wrap items-center justify-center gap-1 lg:w-auto lg:justify-end"
    aria-label="Main navigation"
  >
    {
      sections.map(({ id }) => (
        <a
          href={`/#${id}`}
          class="group flex min-h-11 items-center justify-center gap-0.5 rounded-lg border border-transparent px-2.5 py-2 text-center text-sm font-semibold tracking-[-0.01em] text-[#a5adcb] no-underline transition-colors hover:border-[#363a4f] hover:bg-[#24273a] hover:text-[#cad3f5] active:border-[#494d64] active:bg-[#24273a] sm:px-3"
        >
          <span class="text-[#6e738d] transition-colors group-hover:text-[#8bd5ca]" aria-hidden="true">
            ./
          </span>
          <span>{id.replaceAll("-", " ")}</span>
        </a>
      ))
    }
    <button
      class="group grid h-11 w-11 shrink-0 place-items-center"
      id="cmd-button"
      type="button"
      aria-label="Open command palette"
      title="Open command palette (:)"
    >
      <img
        src="/terminal.svg"
        alt=""
        class="h-[1.125rem] w-[1.125rem] opacity-70 transition-opacity group-hover:opacity-100"
      />
    </button>
  </nav>
</header>
