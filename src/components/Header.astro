---
interface Props {
  name: string;
  sections: { id: string }[];
  homepage?: boolean;
}

const { name, sections } = Astro.props;
---

<header
  class="relative flex flex-col items-center gap-4 border-b border-line pb-4 lg:flex-row lg:justify-between lg:gap-6"
>
  <div
    class="flex min-w-0 w-full items-center justify-center gap-3 lg:w-auto lg:justify-start"
  >
    <h1
      class="m-0 min-w-0 truncate text-lg font-bold tracking-[-0.04em] text-accent sm:text-xl"
    >
      <a
        href="/"
        class="group inline-flex items-center gap-2 text-inherit no-underline"
      >
        {name}
      </a>
    </h1>
  </div>

  <nav
    class="flex w-full flex-wrap items-center justify-center gap-1 lg:w-auto lg:justify-end"
    aria-label="Main navigation"
  >
    {
      sections.map(({ id }) => (
        <a
          href={`/#${id}`}
          class="group flex min-h-11 items-center justify-center gap-0.5 rounded-lg border border-transparent px-2.5 py-2 text-center text-sm font-semibold tracking-[-0.01em] text-secondary no-underline transition-[background-color,border-color,color] hover:border-line hover:bg-panel-hover hover:text-primary active:border-strong active:bg-panel-hover sm:px-3"
        >
          <span
            class="text-faint transition-colors group-hover:text-link"
            aria-hidden="true"
          >
            ./
          </span>
          <span>{id}</span>
        </a>
      ))
    }
  </nav>
</header>
