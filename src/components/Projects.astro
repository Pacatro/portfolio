---
import { GITHUB_TOKEN } from "astro:env/server";
import { portfolio } from "../lib/portfolio";
import { getGitHubProjects } from "../services/github";

const { githubProfile } = portfolio;
const { projects, error: errorKind } = await getGitHubProjects(
  githubProfile,
  GITHUB_TOKEN,
);

const githubUrl = `https://github.com/${githubProfile}?tab=repositories`;
const errorCopy = {
  "rate-limit": "GitHub is temporarily limiting requests.",
  timeout: "GitHub took too long to respond.",
  unavailable: "GitHub could not be reached right now.",
};
---

{
  errorKind && (
    <div class="flex items-center justify-center py-12">
      <div class="max-w-md rounded-xl border border-strong bg-panel p-6">
        <div class="flex items-start">
          <svg
            class="mr-3 h-6 w-6 shrink-0 text-warning"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width={2}
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <div class="min-w-0">
            <h3 class="mb-1 font-semibold text-primary">
              Projects are temporarily unavailable
            </h3>
            <p class="text-sm leading-6 text-secondary">
              {errorCopy[errorKind]} You can still browse every project directly
              on GitHub.
            </p>
            <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-link underline decoration-link/50 underline-offset-4 hover:decoration-link"
              >
                View projects on GitHub
              </a>
              <a
                href="/#projects"
                class="text-secondary underline decoration-secondary/40 underline-offset-4 hover:text-primary"
              >
                Try again
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

{
  !errorKind && projects.length === 0 && (
    <div class="flex items-center justify-center py-12">
      <div class="text-center max-w-md">
        <svg
          class="mx-auto h-12 w-12 text-gray-600 mb-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={2}
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          />
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-primary">
          No public projects found
        </h3>
        <p class="text-sm leading-6 text-secondary">
          The repository list is empty right now. Check the GitHub profile for
          the latest work.
        </p>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-sm font-semibold text-link underline decoration-link/50 underline-offset-4 hover:decoration-link"
        >
          Open GitHub profile
        </a>
      </div>
    </div>
  )
}

{
  !errorKind && projects.length > 0 && (
    <ul class="grid w-full gap-4 md:grid-cols-2">
      {projects.map((repo) => (
        <li class="group relative flex min-w-0 overflow-hidden rounded-xl border border-line bg-panel/90 shadow-[0_1px_0_rgb(var(--color-highlight)_/_0.025)] transition-[background-color,border-color,box-shadow] duration-300 hover:border-accent/50 hover:bg-panel-hover hover:shadow-[0_16px_40px_rgb(var(--color-shadow)_/_0.2)]">
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full min-w-0 flex-col p-5 no-underline active:bg-panel-hover sm:p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <p class="break-words text-lg font-bold leading-6 tracking-[-0.035em] text-accent transition-colors group-hover:text-accent-hover sm:text-xl">
                {repo.name}
              </p>
            </div>
            <p class="mt-3 flex-1 text-sm leading-6 text-secondary sm:text-base sm:leading-7">
              {repo.description || "No description provided."}
            </p>
            <div class="mt-5 flex min-w-0 flex-wrap items-center gap-2 border-t border-line pt-4 text-xs text-muted transition-colors group-hover:border-strong">
              {repo.language && (
                <span class="rounded bg-line px-2 py-1 text-tag">
                  {repo.language}
                </span>
              )}
              {repo.topics.slice(0, 3).map((topic) => (
                <span class="break-all">#{topic}</span>
              ))}
              <span
                class="ml-auto tabular-nums text-warning"
                aria-label={`${repo.stargazers_count} stars`}
              >
                ★ {repo.stargazers_count}
              </span>
            </div>
            <span
              class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100"
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  )
}
