---
import { commands } from "../commands";
import type { SocialLink } from "../lib/portfolio";
interface Props {
  sections: string[];
  socialItems?: SocialLink[];
}
const { sections, socialItems = [] } = Astro.props;
---

<dialog
  id="command-dialog"
  data-sections={JSON.stringify(sections)}
  data-socials={JSON.stringify(socialItems)}
  aria-label="Command palette"
  class="max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-[#494d64] bg-[#1e2030]/95 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.55)] backdrop-blur-xl focus-visible:!outline-none focus-visible:!outline-offset-0"
>
  <p
    class="mb-3 text-[0.625rem] font-bold uppercase tracking-[0.18em] text-[#6e738d]"
  >
    command palette
  </p>
  <div class="flex items-center gap-2 border-b border-[#363a4f] pb-3">
    <span class="text-[#8bd5ca]" aria-hidden="true">›</span><input
      id="command-input"
      type="text"
      spellcheck="false"
      autocomplete="off"
      data-bwignore="true"
      aria-label="Command"
      aria-describedby="command-feedback"
      class="w-full border-none bg-transparent font-mononoki text-base text-[#c6a0f6] caret-[#8bd5ca] outline-none placeholder:text-[#6e738d] focus-visible:!outline-none focus-visible:!outline-offset-0"
      placeholder="Type a command, e.g. :h"
    />
  </div>
  <p
    id="command-feedback"
    class="mt-3 text-sm leading-5 text-[#ed8796]"
    role="status"
    aria-live="polite"
    hidden
  >
  </p>
</dialog>

<dialog
  id="help-dialog"
  aria-labelledby="help-title"
  class="max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto overscroll-contain rounded-2xl border border-[#494d64] bg-[#1e2030]/95 p-4 shadow-[0_24px_80px_rgba(0,0,0,0.55)] backdrop-blur-xl focus-visible:!outline-none focus-visible:!outline-offset-0 sm:p-6"
>
  <p id="help-title" class="mb-4 text-sm font-semibold text-[#8bd5ca]">
    Available commands <span class="font-normal text-[#777c90]"
      >· Esc to close</span
    >
  </p>
  <ul class="list-none divide-y divide-[#363a4f] text-sm">
    {
      commands.map(({ name, args, description }) => (
        <li class="grid min-w-0 gap-1 py-3 font-mononoki font-semibold text-[#c6a0f6] sm:grid-cols-[10rem_minmax(0,1fr)]">
          {name} {args && `<${args}>`}
          <span class="font-normal text-[#a5adcb]">{description}</span>
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  import { runCommand } from "../commands";
  const dialog = document.querySelector("#command-dialog") as HTMLDialogElement;
  const helpDialog = document.querySelector(
    "#help-dialog",
  ) as HTMLDialogElement;
  const input = document.querySelector("#command-input") as HTMLInputElement;
  const button = document.querySelector("#cmd-button") as HTMLButtonElement;
  const feedback = document.querySelector(
    "#command-feedback",
  ) as HTMLParagraphElement;
  const sections = JSON.parse(dialog.dataset.sections ?? "[]") as string[];
  const socialItems = JSON.parse(dialog.dataset.socials ?? "[]");

  const close = () => dialog.close();
  const open = () => {
    helpDialog.close();
    if (!dialog.open) dialog.showModal();
    feedback.hidden = true;
    input.focus();
  };
  const showHelp = () => {
    close();
    helpDialog.showModal();
  };
  const download = (path: string, filename: string) => {
    const link = document.createElement("a");
    link.href = path;
    link.download = filename;
    link.click();
  };
  const goToSection = (sectionId: string) => {
    const section = document.getElementById(sectionId);
    if (section) section.scrollIntoView();
    else window.location.href = `/#${sectionId}`;
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === ":" && !dialog.open && !helpDialog.open) open();
  });
  button.addEventListener("click", open);
  input.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || !input.value.trim()) return;
    const result = runCommand(input.value, {
      close,
      download,
      goToSection,
      help: showHelp,
      sections,
      socialItems,
    });
    if (result) {
      if (result.html) feedback.innerHTML = result.message;
      else feedback.textContent = result.message;
      feedback.hidden = false;
      input.select();
      return;
    }
    input.value = "";
    if (dialog.open) close();
  });
  dialog.addEventListener("close", () => {
    input.value = "";
    feedback.hidden = true;
  });
  for (const modal of [dialog, helpDialog]) {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>
