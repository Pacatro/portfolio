---
import { commands } from "../commands";
interface Props {
  sections: string[];
}
const { sections } = Astro.props;
---

<dialog
  id="command-dialog"
  data-sections={JSON.stringify(sections)}
  aria-label="Command palette"
  class="w-[calc(100%-2rem)] max-w-md rounded-xl border border-[#494d64] bg-[#1e2030] p-4 shadow-[0_18px_55px_rgba(0,0,0,0.45)]"
>
  <input
    id="command-input"
    type="text"
    spellcheck="false"
    autocomplete="off"
    aria-label="Command"
    class="w-full border-none bg-transparent font-mononoki text-base text-[#c6a0f6] caret-[#8bd5ca] outline-none placeholder:text-[#6e738d]"
    placeholder="Type a command, e.g. :h"
  />
</dialog>

<dialog
  id="help-dialog"
  aria-labelledby="help-title"
  class="w-[calc(100%-2rem)] max-w-2xl rounded-xl border border-[#494d64] bg-[#1e2030] p-5 shadow-[0_18px_55px_rgba(0,0,0,0.45)] sm:p-6"
>
  <p id="help-title" class="mb-4 text-sm font-semibold text-[#8bd5ca]">
    Available commands <span class="font-normal text-[#777c90]"
      >· Esc to close</span
    >
  </p>
  <ul class="list-none divide-y divide-[#363a4f] text-sm">
    {
      commands.map(({ name, args, description }) => (
        <li class="grid gap-1 py-3 font-mononoki font-semibold text-[#c6a0f6] sm:grid-cols-[10rem_1fr]">
          {name} {args && `<${args}>`}
          <span class="font-normal text-[#a5adcb]">{description}</span>
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  import { runCommand } from "../commands";
  const dialog = document.querySelector("#command-dialog") as HTMLDialogElement;
  const helpDialog = document.querySelector(
    "#help-dialog",
  ) as HTMLDialogElement;
  const input = document.querySelector("#command-input") as HTMLInputElement;
  const button = document.querySelector("#cmd-button") as HTMLButtonElement;
  const sections = JSON.parse(dialog.dataset.sections ?? "[]") as string[];

  const close = () => dialog.close();
  const open = () => {
    helpDialog.close();
    if (!dialog.open) dialog.showModal();
    input.focus();
  };
  const showHelp = () => {
    close();
    helpDialog.showModal();
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === ":" && !dialog.open && !helpDialog.open) open();
  });
  button.addEventListener("click", open);
  input.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || !input.value.trim()) return;
    runCommand(input.value, { close, help: showHelp, sections });
    input.value = "";
    if (dialog.open) close();
  });
  dialog.addEventListener("close", () => (input.value = ""));
  for (const modal of [dialog, helpDialog]) {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>
