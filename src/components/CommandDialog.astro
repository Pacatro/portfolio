---
import { commands } from "../commands";
interface Props {
  sections: string[];
}
const { sections } = Astro.props;
---

<dialog
  id="command-dialog"
  data-sections={JSON.stringify(sections)}
  class="bg-[#1e1e2e] border-2 border-[#8aadf4] rounded-lg p-4 w-96"
>
  <input
    id="command-input"
    type="text"
    spellcheck="false"
    autocomplete="off"
    class="bg-transparent border-none outline-none text-[#f5bde6] text-lg w-full font-mononoki font-semibold placeholder-gray-500"
    placeholder=":h"
  />
</dialog>

<dialog
  id="help-dialog"
  class="bg-[#222436] border-2 border-[#8aadf4] rounded-lg p-4 w-[80vw] max-w-3xl"
>
  <p class="text-lg sm:text-xl font-bold text-[#a6da95] mb-4">
    Available commands: (ESC for close)
  </p>
  <ul class="text-[#a6da95] text-lg sm:text-xl list-none">
    {
      commands.map(({ name, args, description }) => (
        <li class="font-mononoki font-semibold text-[#f5bde6]">
          {name} {args && `<${args}>`}
          <span class="font-normal text-gray-50"> - {description}</span>
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  import { runCommand } from "../commands";
  const dialog = document.querySelector("#command-dialog") as HTMLDialogElement;
  const helpDialog = document.querySelector(
    "#help-dialog",
  ) as HTMLDialogElement;
  const input = document.querySelector("#command-input") as HTMLInputElement;
  const button = document.querySelector("#cmd-button") as HTMLButtonElement;
  const sections = JSON.parse(dialog.dataset.sections ?? "[]") as string[];

  const close = () => dialog.close();
  const open = () => {
    helpDialog.close();
    if (!dialog.open) dialog.showModal();
    input.focus();
  };
  const showHelp = () => {
    close();
    helpDialog.showModal();
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === ":" && !dialog.open && !helpDialog.open) open();
  });
  button.addEventListener("click", open);
  input.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || !input.value.trim()) return;
    runCommand(input.value, { close, help: showHelp, sections });
    input.value = "";
    if (dialog.open) close();
  });
  dialog.addEventListener("close", () => (input.value = ""));
  for (const modal of [dialog, helpDialog]) {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>
