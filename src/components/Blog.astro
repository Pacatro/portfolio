---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/dates";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const PAGE_SIZE = 5;
---

<div class="blog-list" data-blog-list data-page-size={PAGE_SIZE}>
  <ul class="grid w-full gap-3" aria-live="polite">
    {
      posts.map((post, index) => (
        <li
          data-post
          hidden={index >= PAGE_SIZE}
          class="group relative min-w-0 overflow-hidden rounded-xl border border-line bg-panel/90 shadow-[0_1px_0_rgb(var(--color-highlight)_/_0.025)] transition-[background-color,border-color,box-shadow] duration-300 hover:border-accent/50 hover:bg-panel-hover hover:shadow-[0_16px_40px_rgb(var(--color-shadow)_/_0.2)]"
        >
          <a
            href={`/blog/${post.id}/`}
            class="grid gap-2 p-4 no-underline active:bg-panel-hover sm:grid-cols-[8.5rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-5 sm:p-5"
          >
            <time
              datetime={post.data.publishedAt.toISOString()}
              class="text-xs tabular-nums text-muted"
            >
              {formatDate(post.data.publishedAt)}
            </time>
            <span class="min-w-0">
              <span class="block text-base font-bold tracking-[-0.02em] text-accent transition-colors group-hover:text-accent-hover sm:text-lg">
                {post.data.title}
              </span>
              <span class="mt-1 block text-sm leading-6 text-secondary">
                {post.data.description}
              </span>
              {post.data.tags.length > 0 && (
                <span class="mt-3 flex flex-wrap gap-2 text-xs text-muted">
                  {post.data.tags.map((tag) => (
                    <span class="rounded bg-line px-2 py-1 text-tag">
                      #{tag}
                    </span>
                  ))}
                </span>
              )}
            </span>
            <span class="hidden text-faint transition-colors group-hover:text-accent sm:block" aria-hidden="true">
              →
            </span>
            <span
              class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>

  {
    posts.length > PAGE_SIZE && (
      <nav
        class="mt-4 flex items-center justify-between"
        aria-label="Blog pages"
      >
        <button
          type="button"
          data-previous
          class="min-h-11 px-1 text-sm font-semibold text-secondary transition-colors hover:text-primary disabled:cursor-not-allowed disabled:text-strong"
        >
          ← Newer
        </button>
        <p class="text-xs tabular-nums text-muted" data-page-status />
        <button
          type="button"
          data-next
          class="min-h-11 px-1 text-sm font-semibold text-link transition-colors hover:text-primary disabled:cursor-not-allowed disabled:text-strong"
        >
          Older →
        </button>
      </nav>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-blog-list]").forEach((list) => {
    const posts = [...list.querySelectorAll<HTMLElement>("[data-post]")];
    const previous = list.querySelector<HTMLButtonElement>("[data-previous]");
    const next = list.querySelector<HTMLButtonElement>("[data-next]");
    const status = list.querySelector<HTMLElement>("[data-page-status]");
    const pageSize = Number(list.dataset.pageSize);
    const pages = Math.ceil(posts.length / pageSize);
    let page = 0;

    const showPage = () => {
      const firstPost = page * pageSize;
      const lastPost = firstPost + pageSize;
      posts.forEach((post, index) => {
        post.hidden = index < firstPost || index >= lastPost;
      });
      if (previous) previous.disabled = page === 0;
      if (next) next.disabled = page === pages - 1;
      if (status) status.textContent = `${page + 1} / ${pages}`;
    };

    const changePage = (offset: number) => {
      page += offset;
      showPage();
    };

    previous?.addEventListener("click", () => changePage(-1));
    next?.addEventListener("click", () => changePage(1));
    showPage();
  });
</script>
