---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<section class="mt-16 scroll-mt-6 sm:mt-24 sm:scroll-mt-8" id={id}>
  <div class="mb-7 sm:mb-9">
    <h1
      class="text-xl font-bold leading-7 tracking-[-0.04em] text-primary sm:text-3xl"
    >
      <span class="mr-1 text-link" aria-hidden="true">~/</span>
      {id}
    </h1>
  </div>
  <slot />
</section>
