---
interface Props { id: string; }
const { id } = Astro.props;
---

<section class="mt-14 scroll-mt-6 sm:mt-20 sm:scroll-mt-8" id={id}>
  <div class="mb-6 border-b border-[#363a4f] pb-3">
    <h2 class="text-xl font-bold leading-7 tracking-[-0.02em] text-[#c6a0f6] sm:text-2xl">
      <span class="mr-1 text-[#8bd5ca]" aria-hidden="true">›</span>
      {id}
    </h2>
  </div>
  <slot />
</section>
