---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import CommandDialog from "../../components/CommandDialog.astro";
import { formatDate } from "../../lib/dates";
import { portfolio, sections, sectionIds } from "../../lib/portfolio";
import { features } from "../../lib/features";

export const prerender = true;

export async function getStaticPaths() {
  if (!features.blog) return [];

  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedAt = formatDate(post.data.publishedAt, "long");
const canonicalPath = `/blog/${post.id}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  author: {
    "@type": "Person",
    name: portfolio.name,
    url: Astro.site?.href,
  },
  mainEntityOfPage: Astro.site && new URL(canonicalPath, Astro.site).href,
  keywords: post.data.tags.join(", "),
};
---

<Layout
  title={`${post.data.title} — Paco Algar`}
  description={post.data.description}
  {canonicalPath}
  type="article"
  publishedAt={post.data.publishedAt}
  tags={post.data.tags}
  structuredData={structuredData}
>
  <main class="page-shell min-h-screen">
    <div class="mx-auto w-full max-w-5xl">
      <Header name={portfolio.name} {sections} />

      <article class="mt-16 sm:mt-24">
        <header class="mb-10 pb-3 sm:mb-12">
          <h1
            class="max-w-4xl text-2xl font-bold leading-tight tracking-[-0.045em] text-primary sm:text-4xl"
          >
            <span class="mr-1 text-link" aria-hidden="true">~/</span>
            {post.data.title}
          </h1>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3 text-xs">
            <time
              datetime={post.data.publishedAt.toISOString()}
              class="tabular-nums text-muted"
            >
              {publishedAt}
            </time>

            {
              post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded bg-line px-2 py-1 text-tag">
                      #{tag}
                    </span>
                  ))}
                </div>
              )
            }
          </div>
        </header>
        <div class="prose w-full">
          <Content />
        </div>
        <footer class="mt-12 w-full border-t border-line pt-6 sm:mt-16">
          <a
            href="/#blog"
            class="inline-flex min-h-11 items-center text-sm font-semibold text-link no-underline transition-colors hover:text-primary"
          >
            ← Back to all posts
          </a>
        </footer>
      </article>
    </div>
  </main>
  <CommandDialog sections={sectionIds} socialItems={portfolio.socialLinks} />
</Layout>

<style>
  .prose :global(h2) {
    margin: 3rem 0 1rem;
    color: rgb(var(--color-accent));
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin: 2.25rem 0 0.75rem;
    color: rgb(var(--color-accent));
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.45;
  }
  .prose :global(p),
  .prose :global(li) {
    color: rgb(var(--color-text-secondary));
    line-height: 1.75;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-block: 1.25rem;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: square;
  }
  .prose :global(strong) {
    color: rgb(var(--color-text-primary));
  }
  .prose :global(a) {
    color: rgb(var(--color-link));
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-link) / 50%);
    text-underline-offset: 0.25rem;
  }
  .prose :global(a:hover) {
    text-decoration-color: rgb(var(--color-link));
  }
  .prose :global(blockquote) {
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 1px solid rgb(var(--color-link));
    color: rgb(var(--color-text-secondary));
  }
  .prose :global(blockquote p) {
    color: inherit;
    font-style: italic;
  }
  .prose :global(pre) {
    overflow-x: auto;
    border: 1px solid rgb(var(--color-line));
    border-radius: 0.75rem;
    background: rgb(var(--color-panel));
    padding: 1rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .prose :global(:not(pre) > code) {
    border-radius: 0.25rem;
    background: rgb(var(--color-line));
    padding: 0.15rem 0.35rem;
    color: rgb(var(--color-code));
    font-size: 0.9em;
  }
  .prose :global(pre:focus-visible) {
    outline: 2px solid rgb(var(--color-link));
    outline-offset: 4px;
  }

  @media (max-width: 39.999rem) {
    .prose :global(h2) {
      margin-top: 2.5rem;
      font-size: 1.35rem;
    }
  }
</style>
