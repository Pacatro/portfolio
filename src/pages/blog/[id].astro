---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import CommandDialog from "../../components/CommandDialog.astro";
import { formatDate } from "../../lib/dates";
import { portfolio, sections, sectionIds } from "../../lib/portfolio";
import { features } from "../../lib/features";

export const prerender = true;

export async function getStaticPaths() {
  if (!features.blog) return [];

  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedAt = formatDate(post.data.publishedAt, "long");
---

<Layout
  title={`${post.data.title} — Paco Algar`}
  description={post.data.description}
>
  <main class="page-shell min-h-screen">
    <div class="mx-auto w-full max-w-5xl">
      <Header name={portfolio.name} {sections} />

      <article class="mt-14 sm:mt-20">
        <header class="border-b border-[#363a4f] pb-8 sm:pb-10">
          <div class="w-full">
            <h1
              class="mt-3 text-3xl font-bold leading-tight tracking-[-0.03em] text-[#c6a0f6] sm:text-5xl"
            >
              <span class="mr-1 text-[#8bd5ca]" aria-hidden="true">›</span>
              {post.data.title}
            </h1>
            <div
              class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-xs"
            >
              <time
                datetime={post.data.publishedAt.toISOString()}
                class="tabular-nums text-[#939ab7]"
              >
                {publishedAt}
              </time>

              <div class="flex flex-wrap gap-2">
                {
                  post.data.tags.map((tag) => (
                    <span class="rounded bg-[#363a4f] px-2 py-1 text-[#b8c0e0]">
                      #{tag}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </header>
        <div class="prose mt-9 w-full sm:mt-12">
          <Content />
        </div>
        <footer class="mt-12 w-full border-t border-[#363a4f] pt-6 sm:mt-16">
          <a
            href="/#blog"
            class="inline-flex min-h-11 items-center text-sm font-semibold text-[#8bd5ca] no-underline transition-colors hover:text-[#cad3f5]"
          >
            ← Back to all posts
          </a>
        </footer>
      </article>
    </div>
  </main>
  <CommandDialog sections={sectionIds} />
</Layout>

<style>
  .prose :global(h2) {
    margin: 3rem 0 1rem;
    color: #cad3f5;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin: 2.25rem 0 0.75rem;
    color: #cad3f5;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.45;
  }
  .prose :global(p),
  .prose :global(li) {
    color: #b8c0e0;
    line-height: 1.9;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-block: 1.25rem;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: square;
  }
  .prose :global(strong) {
    color: #cad3f5;
  }
  .prose :global(a) {
    color: #8bd5ca;
    text-decoration: underline;
    text-decoration-color: rgb(139 213 202 / 50%);
    text-underline-offset: 0.25rem;
  }
  .prose :global(a:hover) {
    text-decoration-color: #8bd5ca;
  }
  .prose :global(blockquote) {
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 1px solid #8bd5ca;
    color: #a5adcb;
  }
  .prose :global(blockquote p) {
    color: inherit;
    font-style: italic;
  }
  .prose :global(pre) {
    overflow-x: auto;
    border: 1px solid #363a4f;
    border-radius: 0.75rem;
    background: #1e2030;
    padding: 1rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .prose :global(:not(pre) > code) {
    border-radius: 0.25rem;
    background: #363a4f;
    padding: 0.15rem 0.35rem;
    color: #f5bde6;
    font-size: 0.9em;
  }
  .prose :global(pre:focus-visible) {
    outline: 2px solid #8bd5ca;
    outline-offset: 4px;
  }

  @media (max-width: 39.999rem) {
    .prose :global(h2) {
      margin-top: 2.5rem;
      font-size: 1.35rem;
    }
  }
</style>
