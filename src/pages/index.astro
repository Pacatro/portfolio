---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import content from "../../content.json";
import Section from "../components/Section.astro";
import CommandDialog from "../components/CommandDialog.astro";

export const prerender = true;
---

<Layout>
  <main class="min-h-screen px-4 py-5 sm:px-7 sm:py-8 lg:px-10 lg:py-10">
    <div class="mx-auto w-full max-w-5xl">
      <Header name={content.name} sections={content.sections} />
      {content.sections.map((section) => <Section section={section} />)}
    </div>
  </main>
  <CommandDialog sections={content.sections.map(({ id }) => id)} />
</Layout>
