---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Section from "../components/Section.astro";
import CommandDialog from "../components/CommandDialog.astro";
import { getCollection } from "astro:content";
import {
  portfolio,
  sections,
  sectionIds,
} from "../lib/portfolio";

export const prerender = true;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<Layout>
  <main class="page-shell min-h-screen">
    <div class="mx-auto w-full max-w-5xl">
      <Header name={portfolio.name} {sections} />
      {
        sections.map((section) => (
          <Section section={section} socialItems={portfolio.socialLinks} posts={posts} />
        ))
      }
    </div>
  </main>
  <CommandDialog sections={sectionIds} />
</Layout>
