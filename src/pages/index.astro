---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Section from "../components/Section.astro";
import CommandDialog from "../components/CommandDialog.astro";
import { getCollection } from "astro:content";
import {
  portfolio,
  sections,
  sectionIds,
} from "../lib/portfolio";
import { features } from "../lib/features";
import { getSocialHref, isEmailLink } from "../lib/social-links";

export const prerender = true;

const posts = features.blog
  ? (await getCollection("blog", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
    )
  : [];
const sameAs = portfolio.socialLinks
  .filter((link) => !isEmailLink(link))
  .map(getSocialHref);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: portfolio.name,
  url: Astro.site?.href,
  jobTitle: "Machine Learning Engineer and AI Researcher",
  sameAs,
  knowsAbout: [
    "Machine learning",
    "Artificial intelligence",
    "Computer vision",
    "Recommender systems",
    "Forecasting",
  ],
};
---

<Layout structuredData={structuredData}>
  <main class="page-shell min-h-screen">
    <div class="mx-auto w-full max-w-5xl">
      <Header name={portfolio.name} {sections} homepage />
      {
        sections.map((section) => (
          <Section section={section} socialItems={portfolio.socialLinks} posts={posts} />
        ))
      }
      <footer
        class="mt-20 border-t border-[#363a4f] pt-7 text-center text-xs tracking-[0.01em] text-[#939ab7] sm:mt-28 sm:pt-8"
      >
        <p class="m-0 inline-flex items-baseline gap-x-1.5">
          <span>Made with</span>
          <span
            class="inline-block translate-y-px text-[#c6a0f6]"
            aria-hidden="true">❤</span
          >
          <span class="sr-only">love</span>
          <span>by</span>
          <span class="font-semibold text-[#a5adcb]">{portfolio.shortName}</span>
        </p>
      </footer>
    </div>
  </main>
  <CommandDialog sections={sectionIds} socialItems={portfolio.socialLinks} />
</Layout>
