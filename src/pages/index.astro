---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import content from "../../content.json";
import Section from "../components/Section.astro";
import CommandDialog from "../components/CommandDialog.astro";

export const prerender = true;
---

<Layout>
  <main class="flex flex-col items-center justify-center p-0 sm:p-10">
    <div class="w-full max-w-4xl">
      <Header name={content.name} sections={content.sections} />
      {content.sections.map((section) => <Section section={section} />)}
    </div>
  </main>
  <CommandDialog sections={content.sections.map(({ id }) => id)} />
</Layout>
